{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "admin-portal": {
      "root": "admin-portal",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "admin-portal"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
